{
  "expo": {
    "name": "Ride Madison",
    "slug": "ride-madison",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ridemadison",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ridemadison.app",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14213D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ridemadison.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14213D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ride Madison uses your location to show nearby paths, BCycle and shops, plan routes from where you are, and give turn-by-turn directions."
        }
      ],
      "expo-sharing",
      "expo-apple-authentication"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
